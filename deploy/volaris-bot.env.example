# Example environment file for volaris-bot service
# Copy this file to /etc/volaris-bot.env and fill with your real values.
# IMPORTANT: keep this file readable only by root (chmod 600) and do NOT commit it to version control.

# Telegram bot token (from BotFather)
TELEGRAM_TOKEN=your_bot_token_here
# Telegram chat id (numeric) where notifications will be sent
TELEGRAM_CHAT_ID=your_chat_id_here
# Optional overrides:
# CONCURRENCY=3
# INITIAL_INTERVAL=20
# MAX_INTERVAL=600
# JITTER=5
# OUTPUT_DIR=/path/to/outputs
# CREDENTIALS_FILE=/path/to/credentials.json
